# ============================================================================
# Leave Information Bubble — 环境变量配置
# 复制本文件为 .env（.env 已被 gitignore，绝不会被提交）：
#   Windows: copy .env.example .env
#   macOS/Linux: cp .env.example .env
# 详细教程见 docs/getting-started.md
# ============================================================================

# --- DeepSeek API（真实 wake 必填；离线 demo 不需要） ---
# 获取：https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=sk-your-key-here
DEEPSEEK_BASE_URL=https://api.deepseek.com

# --- B站 Cookie（可选；提升 B站采集质量） ---
# 获取步骤（见 docs/getting-started.md §4.2）：
# 1. 登录 bilibili.com
# 2. F12 → Application → Cookies → bilibili.com
# 3. 复制 SESSDATA 一行的 Value
# 注意：只读操作（搜索、视频信息）只需 SESSDATA 一个字段；
#       建议使用专用账号，不要用主账号。
BILIBILI_SESSDATA=your-sessdata-here

# --- NGA Cookie（可选；NGA 部分接口要求浏览器会话） ---
# 获取步骤（见 docs/getting-started.md §4.2）：
# 1. 登录 bbs.nga.cn
# 2. F12 → Network → 任意请求的 Request Headers
# 3. 复制整个 Cookie 值（不含开头的 "Cookie:" 字样）
NGA_COOKIE=

# --- 可选开关 ---
# 本地没有 whisper 模型时，关闭 ASR 转写工具（默认 true）：
# ASR_ENABLED=false
